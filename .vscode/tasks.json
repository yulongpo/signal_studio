{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Signal Studio: Configure Debug",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/scripts/configure.ps1", "-Preset", "windows-msvc-debug"],
      "problemMatcher": ["$msCompile"]
    },
    {
      "label": "Signal Studio: Build Debug",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/scripts/build.ps1", "-Preset", "windows-msvc-debug"],
      "dependsOn": "Signal Studio: Configure Debug",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$msCompile"]
    },
    {
      "label": "Signal Studio: Test Debug",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/scripts/test.ps1", "-Preset", "windows-msvc-debug"],
      "dependsOn": "Signal Studio: Build Debug",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Signal Studio: Build Release",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/scripts/build.ps1", "-Preset", "windows-msvc-release"],
      "group": "build",
      "problemMatcher": ["$msCompile"]
    },
    {
      "label": "Signal Studio: Test Release",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/scripts/test.ps1", "-Preset", "windows-msvc-release"],
      "dependsOn": "Signal Studio: Build Release",
      "group": "test",
      "problemMatcher": []
    }
  ]
}
