{
  "version": 8,
  "cmakeMinimumRequired": { "major": 3, "minor": 28, "patch": 0 },
  "configurePresets": [
    {
      "name": "windows-msvc-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "installDir": "${sourceDir}/build/install/${presetName}",
      "cacheVariables": {
        "BUILD_TESTING": "ON",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "SIGNAL_STUDIO_BUILD_TESTS": "ON",
        "SIGNAL_STUDIO_BUILD_SDK_EXAMPLE": "ON"
      }
    },
    {
      "name": "windows-msvc-ui-base",
      "hidden": true,
      "inherits": "windows-msvc-base",
      "cacheVariables": {
        "SIGNAL_STUDIO_BUILD_UI": "ON",
        "SIGNAL_STUDIO_QT_ROOT": "$env{SIGNAL_STUDIO_QT_ROOT}"
      }
    },
    {
      "name": "windows-msvc-debug",
      "inherits": "windows-msvc-ui-base",
      "displayName": "Windows MSVC Debug (UI)",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "SIGNAL_STUDIO_CUDA_MODE": "AUTO" }
    },
    {
      "name": "windows-msvc-release",
      "inherits": "windows-msvc-ui-base",
      "displayName": "Windows MSVC Release (UI)",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "SIGNAL_STUDIO_CUDA_MODE": "AUTO" }
    },
    {
      "name": "windows-msvc-relwithdebinfo",
      "inherits": "windows-msvc-ui-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo", "SIGNAL_STUDIO_CUDA_MODE": "AUTO" }
    },
    {
      "name": "windows-msvc-cpu-debug",
      "inherits": "windows-msvc-debug",
      "cacheVariables": { "SIGNAL_STUDIO_CUDA_MODE": "OFF" }
    },
    {
      "name": "windows-msvc-cpu-release",
      "inherits": "windows-msvc-release",
      "cacheVariables": { "SIGNAL_STUDIO_CUDA_MODE": "OFF" }
    },
    {
      "name": "windows-msvc-cuda-debug",
      "inherits": "windows-msvc-debug",
      "cacheVariables": { "SIGNAL_STUDIO_CUDA_MODE": "ON" }
    },
    {
      "name": "windows-msvc-cuda-release",
      "inherits": "windows-msvc-release",
      "cacheVariables": { "SIGNAL_STUDIO_CUDA_MODE": "ON" }
    },
    {
      "name": "windows-msvc-headless-debug",
      "inherits": "windows-msvc-base",
      "displayName": "Windows MSVC Debug (no Qt)",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "SIGNAL_STUDIO_BUILD_UI": "OFF", "SIGNAL_STUDIO_CUDA_MODE": "OFF" }
    },
    {
      "name": "windows-msvc-headless-release",
      "inherits": "windows-msvc-base",
      "displayName": "Windows MSVC Release (no Qt)",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "SIGNAL_STUDIO_BUILD_UI": "OFF", "SIGNAL_STUDIO_CUDA_MODE": "OFF" }
    }
  ],
  "buildPresets": [
    { "name": "windows-msvc-debug", "configurePreset": "windows-msvc-debug", "jobs": 0 },
    { "name": "windows-msvc-release", "configurePreset": "windows-msvc-release", "jobs": 0 },
    { "name": "windows-msvc-relwithdebinfo", "configurePreset": "windows-msvc-relwithdebinfo", "jobs": 0 },
    { "name": "windows-msvc-cpu-debug", "configurePreset": "windows-msvc-cpu-debug", "jobs": 0 },
    { "name": "windows-msvc-cpu-release", "configurePreset": "windows-msvc-cpu-release", "jobs": 0 },
    { "name": "windows-msvc-cuda-debug", "configurePreset": "windows-msvc-cuda-debug", "jobs": 0 },
    { "name": "windows-msvc-cuda-release", "configurePreset": "windows-msvc-cuda-release", "jobs": 0 },
    { "name": "windows-msvc-headless-debug", "configurePreset": "windows-msvc-headless-debug", "jobs": 0 },
    { "name": "windows-msvc-headless-release", "configurePreset": "windows-msvc-headless-release", "jobs": 0 }
  ],
  "testPresets": [
    { "name": "windows-msvc-debug", "configurePreset": "windows-msvc-debug", "output": { "outputOnFailure": true }, "execution": { "noTestsAction": "error" } },
    { "name": "windows-msvc-release", "configurePreset": "windows-msvc-release", "output": { "outputOnFailure": true }, "execution": { "noTestsAction": "error" } },
    { "name": "windows-msvc-cpu-debug", "configurePreset": "windows-msvc-cpu-debug", "output": { "outputOnFailure": true }, "execution": { "noTestsAction": "error" } },
    { "name": "windows-msvc-cpu-release", "configurePreset": "windows-msvc-cpu-release", "output": { "outputOnFailure": true }, "execution": { "noTestsAction": "error" } },
    { "name": "windows-msvc-cuda-debug", "configurePreset": "windows-msvc-cuda-debug", "output": { "outputOnFailure": true }, "execution": { "noTestsAction": "error" } },
    { "name": "windows-msvc-cuda-release", "configurePreset": "windows-msvc-cuda-release", "output": { "outputOnFailure": true }, "execution": { "noTestsAction": "error" } },
    { "name": "windows-msvc-headless-debug", "configurePreset": "windows-msvc-headless-debug", "output": { "outputOnFailure": true }, "execution": { "noTestsAction": "error" } },
    { "name": "windows-msvc-headless-release", "configurePreset": "windows-msvc-headless-release", "output": { "outputOnFailure": true }, "execution": { "noTestsAction": "error" } }
  ]
}
