@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
set(_SignalStudio_supported_components Core Data DSP Compute TaskRuntime PluginSDK ModelRuntime Dataset Visualization Workbench)
set(_SignalStudio_ui_components Visualization Workbench)
set(_SignalStudio_ui_built @SIGNAL_STUDIO_BUILD_UI@)

include("${CMAKE_CURRENT_LIST_DIR}/SignalStudioHeadlessTargets.cmake")

set(_SignalStudio_needs_ui FALSE)
foreach(_component IN LISTS SignalStudio_FIND_COMPONENTS)
  if(NOT _component IN_LIST _SignalStudio_supported_components)
    set(SignalStudio_${_component}_FOUND FALSE)
    set(SignalStudio_NOT_FOUND_MESSAGE "Unsupported SignalStudio component: ${_component}")
  elseif(_component IN_LIST _SignalStudio_ui_components)
    set(_SignalStudio_needs_ui TRUE)
  else()
    set(SignalStudio_${_component}_FOUND TRUE)
  endif()
endforeach()

if(_SignalStudio_needs_ui)
  if(NOT _SignalStudio_ui_built)
    foreach(_component IN LISTS _SignalStudio_ui_components)
      if(_component IN_LIST SignalStudio_FIND_COMPONENTS)
        set(SignalStudio_${_component}_FOUND FALSE)
      endif()
    endforeach()
    set(SignalStudio_NOT_FOUND_MESSAGE "This SignalStudio installation was built without UI components")
  else()
    find_dependency(Qt6 @SIGNAL_STUDIO_MINIMUM_QT_VERSION@ COMPONENTS Core Widgets)
    include("${CMAKE_CURRENT_LIST_DIR}/SignalStudioUiTargets.cmake")
    foreach(_component IN LISTS _SignalStudio_ui_components)
      if(_component IN_LIST SignalStudio_FIND_COMPONENTS)
        set(SignalStudio_${_component}_FOUND TRUE)
      endif()
    endforeach()
  endif()
endif()

check_required_components(SignalStudio)
